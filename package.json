{
  "name": "atelier-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "auth:role": "tsx --env-file=.env src/db/set-role.ts",
    "auth:generate": "npx auth@1.7.27 generate --config src/lib/auth.ts --output src/db/auth-schema.ts",
    "test:auth": "tsx --env-file=.env --test --test-concurrency=1 scripts/verify-auth.ts",
    "test:cart": "tsx --env-file=.env --test --test-concurrency=1 scripts/verify-cart.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "better-auth": "^1.7.27",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
